{
  "name": "depgraph",
  "version": "0.1.0",
  "description": "Multi-language dependency graph analyzer - detect cycles, measure coupling, visualize architecture",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "depgraph": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "tsx src/cli.ts",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "lint": "echo 'linting skipped'",
    "smoke": "bash scripts/smoke.sh",
    "prepublishOnly": "npm run build",
    "package:smoke": "npm run build && npm pack --dry-run",
    "release:check": "npm test && npm run check && npm run build && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "dependency-graph",
    "dependency-analysis",
    "circular-dependency",
    "coupling-metrics",
    "architecture-visualization",
    "typescript",
    "python",
    "go",
    "static-analysis",
    "cli"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rogerchappel/depgraph"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/depgraph/issues"
  },
  "homepage": "https://github.com/rogerchappel/depgraph#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/yargs": "^17.0.32",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
